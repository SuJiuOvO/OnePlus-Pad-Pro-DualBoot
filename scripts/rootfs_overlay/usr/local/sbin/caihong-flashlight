#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# Copyright (c) 2026 Osilvfe <osilvfe@gmail.com>
set -eu

usage() {
	echo "usage: caihong-flashlight {on [0-100]|off|status} [rear|all]" >&2
	exit 2
}

command=${1:-}
case "$command" in
	on)
		requested_level=${2:-40}
		target=${3:-rear}
		[ "$#" -le 3 ] || usage
		case "$requested_level" in
			''|*[!0-9]*) usage ;;
		esac
		[ "$requested_level" -le 100 ] || usage
		;;
	off|status)
		requested_level=
		target=${2:-rear}
		[ "$#" -le 2 ] || usage
		;;
	*) usage ;;
esac

case "$target" in
	rear|all) ;;
	*) usage ;;
esac

# OnePlus Pad Pro (Caihong) wires its rear LED flash to PM8550 ch0 (yellow:flash-0).
# Ch1 (white:flash) is unpopulated and raises open-circuit fault (0xee06=0x08).
sysfs_flash_nodes() {
	if [ "$target" = rear ] && [ -d /sys/class/leds/yellow:flash-0 ]; then
		echo /sys/class/leds/yellow:flash-0
		return 0
	fi
	for node in /sys/class/leds/*:flash-0 /sys/class/leds/*:flash-* /sys/class/leds/*:flash; do
		[ -d "$node" ] || continue
		case "$target:${node##*/}" in
			rear:white:*) continue ;;
		esac
		echo "$node"
	done
}

# Only query V4L2 flash subdevs (never probe csiphy/isp subdevs, which can block in ioctl).
v4l_flash_nodes() {
	command -v v4l2-ctl >/dev/null 2>&1 || return 0
	for node in /dev/v4l-subdev*; do
		[ -e "$node" ] || continue
		name=$(cat "/sys/class/video4linux/${node##*/}/name" 2>/dev/null || true)
		case "$name" in
			*flash*) ;;
			*) continue ;;
		esac
		if [ "$target" = rear ] && [ "$name" = "white:flash" ] && [ -d /sys/class/leds/yellow:flash-0 ]; then
			continue
		fi
		if timeout 2 v4l2-ctl -d "$node" --all 2>/dev/null | grep -q '^Flash Controls'; then
			echo "$node"
		fi
	done
}

nodes=$(sysfs_flash_nodes)
if [ -n "$nodes" ]; then
	if [ "$command" = status ]; then
		brightness=0
		for node in $nodes; do
			value=$(cat "$node/brightness" 2>/dev/null || echo 0)
			[ "$value" -gt "$brightness" ] && brightness=$value
		done
		printf 'rear: brightness=%s\n' "$brightness"
		exit 0
	fi

	for node in $nodes; do
		if [ "$command" = on ]; then
			if [ "$requested_level" -eq 0 ]; then
				val=0
			else
				val=$(( (requested_level * 255 + 50) / 100 ))
				[ "$val" -ge 1 ] || val=1
				[ "$val" -le 255 ] || val=255
			fi
			printf '%s\n' "$val" > "$node/brightness"
		else
			printf '0\n' > "$node/brightness"
		fi
	done
	exit 0
fi

set -- $(v4l_flash_nodes)
if [ "$command" = status ]; then
	if [ "$#" -gt 0 ]; then
		printf 'rear: '
		timeout 2 v4l2-ctl -d "$1" --get-ctrl=led_mode,intensity_torch_mode 2>/dev/null || true
	else
		echo 'rear: brightness=0'
	fi
	exit 0
fi

if [ "$#" -gt 0 ]; then
	if [ "$command" = on ]; then
		intensity=$((requested_level * 500000 / 100))
		[ "$intensity" -ge 12500 ] || intensity=12500
		for node do
			timeout 2 v4l2-ctl -d "$node" --set-ctrl="intensity_torch_mode=$intensity,led_mode=2"
		done
	else
		for node do
			timeout 2 v4l2-ctl -d "$node" --set-ctrl=led_mode=0
		done
	fi
fi

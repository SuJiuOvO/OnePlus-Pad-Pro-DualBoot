+static void oneplus_pogo_detach_inputs(struct oneplus_pogo *pogo)
+{
+	struct input_dev *kbd, *tp;
+
+	mutex_lock(&pogo->lock);
+	kbd = pogo->keyboard;
+	tp = pogo->touchpad;
+	pogo->keyboard = NULL;
+	pogo->touchpad = NULL;
+	mutex_unlock(&pogo->lock);
 
-	return input_register_device(pogo->touchpad);
+	if (tp)
+		input_unregister_device(tp);
+	if (kbd)
+		input_unregister_device(kbd);
+}
+
+static void oneplus_pogo_unregister_inputs_action(void *data)
+{
+	oneplus_pogo_detach_inputs(data);
+}
+
+static void oneplus_pogo_input_work(struct work_struct *work)
+{
+	struct oneplus_pogo *pogo = container_of(work, struct oneplus_pogo,
+						  input_work);
+	bool attached, have_inputs;
+	int ret;
+
+	mutex_lock(&pogo->input_lock);
+	mutex_lock(&pogo->lock);
+	attached = pogo->attached;
+	have_inputs = pogo->keyboard && pogo->touchpad;
+	mutex_unlock(&pogo->lock);
+
+	if (attached && !have_inputs) {
+		ret = oneplus_pogo_attach_inputs(pogo);
+		if (ret)
+			dev_err(&pogo->serdev->dev,
+				"failed to register attached pogo inputs: %d\n", ret);
+	} else if (!attached && have_inputs) {
+		oneplus_pogo_detach_inputs(pogo);
+	}
+	mutex_unlock(&pogo->input_lock);
 }
 
